# Copy this file to .env and fill in your credentials

# Option A: Standard Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Option B: Azure AI Foundry
ANTHROPIC_FOUNDRY_API_KEY=your-azure-key
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# Base URL will be: https://{ANTHROPIC_FOUNDRY_RESOURCE}.services.ai.azure.com/anthropic
# Override if your endpoint differs:
# ANTHROPIC_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
